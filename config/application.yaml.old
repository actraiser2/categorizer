
spring:
  banner:
    location: classpath:/META-INF/banner.txt
  jackson:
    date-format: yyyy-MM-dd:'T'HH:mm:ss
  security:
    oauth2:
      resourceserver:
        jwt:
          issuer-uri: http://192.168.1.39:9090/realms/josemi
          #jwk-set-uri: http://192.168.1.39:9090/realms/josemi/protocol/openid-connect/certs
  sql:
    init:
      platform: postgresql          
  datasource:
      url: jdbc:postgresql://192.168.1.39:5432/categorizer
      username: postgres
      password: fenix000
      hikari:
        maximum-pool-size: 15
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
  config:
    additional-location: file:./config/application2.yaml
  kafka:
    bootstrap-servers:
    - localhost:9092
    properties:
      "[schema.registry.url]": http://localhost:9093
    consumer:
      auto-commit-interval: 2
      max-poll-records: 1
      enable-auto-commit: true
      value-deserializer: io.confluent.kafka.serializers.KafkaAvroDeserializer
      key-deserializer: org.apache.kafka.common.serialization.StringDeserializer
      properties:
        "[specific.avro.reader]": true
        "[max.poll.interval.ms]": "10000"
    producer:
      value-serializer: io.confluent.kafka.serializers.KafkaAvroSerializer
      key-serializer: org.apache.kafka.common.serialization.StringSerializer
      acks: 1
      properties:
        "[partitioner.class]": com.santalucia.categorizer.infrastructure.partitioners.CustomPartitioner
  cloud:
    function:
      definition: usersResp
    stream:
      
      bindings:
        categorization-req-out-0: 
          destination: categorization
            
        categorization-resp-in-0:
          destination: categorization
          group: ${spring.application.name}
        users-out-0:
          destination: users
          content-type: application/*+avro
          producer:
            use-native-encoding: true
            
              
        usersResp-in-0:
          group: ${spring.application.name}
          destination: users
          
        prueba-kafkastream-out-0:
          destination: prueba-kafkastreams
          content-type: application/json
          producer:
            use-native-encoding: true
      
      kafka:
        bindings:
          prueba-kafkastream-out-0:
            producer:
              configuration:
                value.serializer: com.santalucia.categorizer.infrastructure.serdes.MovementEntitySerializer
                key.serializer: org.apache.kafka.common.serialization.LongSerializer
                 
            
      
grpc:
  server:
    port: 9091
    
kstream:
  bootstrap-server: localhost:9092
  application-id: categorizerStream
  consumer:
    "[max.poll.interval.ms]": 10000
  producer:
    acks: all